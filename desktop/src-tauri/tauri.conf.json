{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShardCut",
  "version": "0.1.0",
  "identifier": "dev.shardcut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShardCut",
        "width": 1180,
        "height": 760,
        "minWidth": 1180,
        "minHeight": 760,
        "maxWidth": 1180,
        "maxHeight": 760,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
